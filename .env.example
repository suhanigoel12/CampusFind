# Port for the Express server to listen on
PORT=5000

# MongoDB Atlas connection string
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
# Example: mongodb+srv://student:mypassword123@cluster0.xyzab.mongodb.net/campusfind?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xyzab.mongodb.net/campusfind?retryWrites=true&w=majority

# Secret key used for signing JSON Web Tokens (JWT)
JWT_SECRET=supersecretcampusfindjwtkey_change_in_production

# JWT Expiration time (e.g., 1d, 7d, 30d)
JWT_EXPIRE=7d
